---
import { newsletter } from '../site';

const configured = /^\d+$/.test(newsletter.accountId) && /^[a-zA-Z0-9]+$/.test(newsletter.formCode);
const initialization = configured
  ? `(function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[]).push(arguments);};l=d.createElement(e);l.async=1;l.src=u;n=d.getElementsByTagName(e)[0];n.parentNode.insertBefore(l,n);})(window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');ml('account',${JSON.stringify(newsletter.accountId)});`
  : '';
---
{configured ? (
  <>
    <script is:inline set:html={initialization}></script>
    <div class="ml-embedded" data-form={newsletter.formCode}></div>
  </>
) : <p class="form-status">Online signup is coming soon.</p>}
{newsletter.hostedFormUrl && <p><a class="text-link" href={newsletter.hostedFormUrl}>Open the signup form</a></p>}
