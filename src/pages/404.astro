---
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';
---
<Base title="Page not found" canonicalPath={path('404.html')}>
  <div class="shell page-space">
    <h1>Page not found</h1>
    <p><a class="text-link" href={path()}>Return to the homepage</a></p>
  </div>
</Base>
