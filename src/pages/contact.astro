---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { group } from '../site';
---
<Base title="Contact & Subscribe" description="Ask a question, get involved, or subscribe to desert conservation news and meeting reminders.">
  <div class="shell page-space">
    <div class="page-heading">
      <h1>Contact &amp; subscribe</h1>
      <p class="lead">Bring a question, suggest a meeting topic, or hear about the next Zoom conversation.</p>
    </div>
    <div class="two-columns">
      <section>
        <h2>Contact the group</h2>
        <p>We welcome questions about meetings, volunteering, and desert conservation.</p>
        {group.contactEmail
          ? <p><a class="text-link" href={`mailto:${group.contactEmail}`}>{group.contactEmail}</a></p>
          : <p class="muted">A contact address will be posted when available.</p>}
      </section>
      <section class="form-panel" id="newsletter">
        <h2>Subscribe to email updates</h2>
        <p>Receive meeting notices, environmental news, and announcements from {group.name}.</p>
        <Newsletter />
        <h3>Newsletter privacy</h3>
        <p>MailerLite processes your email address and any name you choose to provide so that we can send updates. You can unsubscribe using the link in each newsletter.</p>
        <a class="text-link" href="https://www.mailerlite.com/legal/privacy-policy">MailerLite privacy policy</a>
      </section>
    </div>
  </div>
</Base>
