---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { group } from '../site';
---
<Base title="Contact & Sign Up" description="Contact the Borrego Environmental Committee or sign up to volunteer with us for free.">
  <div class="shell page-space">
    <div class="page-heading">
      <h1>Contact &amp; sign up</h1>
    </div>
    <div class="two-columns">
      <section>
        <h2>Contact the group</h2>
        <p>We welcome questions about meetings, volunteering, and desert conservation.</p>
        {group.contactEmail
          ? <p><a class="text-link" href={`mailto:${group.contactEmail}`}>{group.contactEmail}</a></p>
          : <p class="muted">A contact address will be posted when available.</p>}
      </section>
      <section class="form-panel" id="newsletter" aria-label="Group signup">
        <Newsletter />
        <h2>Signup privacy</h2>
        <p>MailerLite uses your email address and optional first name to manage your signup and send group messages. You can unsubscribe using the link in each group email.</p>
        <a class="text-link" href="https://www.mailerlite.com/legal/privacy-policy">MailerLite privacy policy</a>
      </section>
    </div>
  </div>
</Base>
