---
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';
---
<Base title="About Us" description="Learn about our focus on desert conservation, environmental education, and volunteering.">
  <div class="shell page-space">
    <div class="split-feature">
      <div>
        <p class="eyebrow">About us</p>
        <h1>Care for the desert starts close to home</h1>
        <p class="lead">Our mission is to help people understand desert environments and take part in caring for them.</p>
      </div>
      <img src={path('images/desert-mountains.jpg')} width="887" height="443" alt="Warm sunlight on a rocky desert ridge and hillside saguaros" />
    </div>
    <div class="detail-grid">
      <section><h2>Conservation &amp; education</h2><p>We focus on native plants, wildlife, and the habitats that sustain them. Our news and meeting conversations are a place to learn about the desert and share what we notice outdoors.</p></section>
      <section><h2>Community involvement</h2><p>Join a monthly Zoom conversation, bring a question, or suggest a topic you’d like to explore.</p><a class="text-link" href={path('meetings/')}>Explore monthly meetings</a></section>
      <section><h2>Volunteer</h2><p>Interested in research, writing, photography, or helping with Zoom? Reach out about the skills or interests you’d like to share.</p><a class="text-link" href={path('contact/')}>Contact the group</a></section>
    </div>
  </div>
</Base>
