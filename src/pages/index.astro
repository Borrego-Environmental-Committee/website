---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import MeetingCard from '../components/MeetingCard.astro';
import { group } from '../site';
import { upcomingMeetings } from '../meetings';
import { publishedNews } from '../lib/news';
import { path } from '../lib/paths';

const latest = (await publishedNews()).slice(0, 3);
const [meeting] = upcomingMeetings();
---
<Base>
  <section class="hero">
    <img class="hero-photo" src={path('images/desert-sunset.jpg')} alt="" fetchpriority="high" decoding="async" />
    <div class="shell hero-content">
      <p class="eyebrow">Desert conservation &amp; community</p>
      <h1>A place for people<br class="desktop-break" /> who love the desert.</h1>
      <p>{group.description}</p>
      <div class="actions">
        <a class="button primary" href={path('meetings/')}>See our next meeting</a>
        <a class="button ghost" href={path('contact/#newsletter')}>Get email updates</a>
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="shell intro-grid">
      <div>
        <p class="eyebrow">About the circle</p>
        <h2>Get to know the desert</h2>
        <p>We’re a small volunteer group with a shared interest in desert conservation. Our monthly conversations and news explore desert wildlife, native plants, and ways to care for the places we share.</p>
        <a class="text-link" href={path('about/')}>More about our group</a>
      </div>
      <section aria-labelledby="home-meeting">
        <h2 class="eyebrow" id="home-meeting">Next monthly Zoom meeting</h2>
        <MeetingCard meeting={meeting} linkToSchedule />
      </section>
    </div>
  </section>

  <section class="news-section">
    <div class="shell">
      <div class="section-head">
        <h2>News &amp; announcements</h2>
        <a class="text-link" href={path('news/')}>View the news archive</a>
      </div>
      <div class="card-grid">{latest.map((entry) => <NewsCard entry={entry} />)}</div>
    </div>
  </section>

  <section class="signup-banner">
    <div class="shell banner-inner">
      <div>
        <h2>A little desert in your inbox</h2>
        <p>Get monthly Zoom meeting notices and desert conservation news by email.</p>
      </div>
      <a class="button light" href={path('contact/#newsletter')}>Newsletter signup</a>
    </div>
  </section>
</Base>
